FROM arm64v8/golang:1.27.3-alpine3.24

RUN apk update upgrade --no-cache && \
    apk add --no-cache \
        bash \
        build-base \
        curl

# this is not the preferred way to install golangci-lint, see the commented curl command below
# see: https://golangci-lint.run/docs/welcome/install/local/#docker for preferred installation
# the reason we are installing it this way is there seems to have been major breaking changes in how
# golang is compiled between versions 1.27.0 and 1.27.3.  golang 1.27.3 is required for security issues
# golangci-lint v2.15.0
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@25c5369a93aacb8cccea0d46e1569ca4a194564d
# RUN curl -sSfL --proto-default https --proto https \
#     https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh \
#     | sh -s -- -b $(go env GOPATH)/bin v2.13.2

# this gosec ref is not an official release and may not be stable.  see above notes about issues with golang 1.27.3
RUN go install github.com/xo/usql@v0.17.5 && \
    go install github.com/securego/gosec/v2/cmd/gosec@14ef84f6feccf40be7f5092fd2db119bf3f5f836 && \
    go install gotest.tools/gotestsum@v1.13.0 && \
    go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.15.2

WORKDIR /go/src/github.com/CMSgov/bcda-ssas-app
COPY . .

ENTRYPOINT []
